<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><corners android:radius="16dp" /><solid android:color="#332196F3" /><stroke android:width="3dp" android:color="@color/focus_glow" /></shape></item>
    <item android:state_pressed="true"><shape><corners android:radius="16dp" /><solid android:color="#222196F3" /></shape></item>
    <item android:state_activated="true"><shape><corners android:radius="16dp" /><solid android:color="#332196F3" /></shape></item>
    <item><shape><corners android:radius="16dp" /><solid android:color="#00000000" /></shape></item>
</selector>
