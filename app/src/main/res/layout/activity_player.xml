<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glossy"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_round_btn"
            android:contentDescription="@string/close"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- playing queue: see the list, tap to play, delete -->
        <ImageButton
            android:id="@+id/btnList"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_round_btn"
            android:contentDescription="@string/playing_queue"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_queue" />
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

    <FrameLayout
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_cover"
        android:clipToOutline="true"
        android:elevation="14dp">

        <!-- album art (or a music note when the song has no cover) -->
        <ImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="84dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_music_big" />
    </FrameLayout>

    <TextView
        android:id="@+id/songTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:ellipsize="marquee"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/songFolder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="#CCFFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/songCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_chip"
        android:paddingStart="12dp"
        android:paddingTop="3dp"
        android:paddingEnd="12dp"
        android:paddingBottom="3dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />

    <!-- animated equalizer: dances while music plays -->
    <com.mbnetwork.filemanager.EqualizerView
        android:id="@+id/equalizer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="24dp" />

    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

    <SeekBar
        android:id="@+id/seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxWidth="600dp"
        android:progressBackgroundTint="#55FFFFFF"
        android:progressTint="#FFFFFF"
        android:thumbTint="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView android:id="@+id/position" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#DDFFFFFF" android:textSize="12sp" />
        <TextView android:id="@+id/duration" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#DDFFFFFF" android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton android:id="@+id/btnShuffle" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_margin="6dp" android:background="@drawable/bg_round_btn" android:contentDescription="@string/shuffle"
            android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_shuffle" />
        <ImageButton android:id="@+id/btnPrev" android:layout_width="60dp" android:layout_height="60dp"
            android:layout_margin="6dp" android:background="@drawable/bg_round_btn" android:contentDescription="@string/previous"
            android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_prev" />
        <ImageButton android:id="@+id/btnPlay" android:layout_width="80dp" android:layout_height="80dp"
            android:layout_margin="6dp" android:background="@drawable/bg_play_btn" android:contentDescription="@string/play"
            android:elevation="6dp" android:padding="20dp" android:scaleType="fitCenter" android:src="@drawable/ic_pause" />
        <ImageButton android:id="@+id/btnNext" android:layout_width="60dp" android:layout_height="60dp"
            android:layout_margin="6dp" android:background="@drawable/bg_round_btn" android:contentDescription="@string/next"
            android:padding="14dp" android:scaleType="fitCenter" android:src="@drawable/ic_next" />
        <ImageButton android:id="@+id/btnRepeat" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_margin="6dp" android:background="@drawable/bg_round_btn" android:contentDescription="@string/repeat"
            android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_repeat" />
    </LinearLayout>

    <ImageButton android:id="@+id/btnStop" android:layout_width="44dp" android:layout_height="44dp"
        android:background="@drawable/bg_round_btn" android:contentDescription="@string/stop"
        android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/ic_stop" />
</LinearLayout>
