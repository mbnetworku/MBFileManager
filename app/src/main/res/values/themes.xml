<resources>
    <style name="Theme.MBFileManager" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="android:windowBackground">@drawable/bg_window</item>
        <item name="android:statusBarColor">@color/grad_start</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.MBFileManager.Dialog</item>
    </style>
    <style name="ThemeOverlay.MBFileManager.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/RoundedDialog</item>
    </style>
    <style name="RoundedDialog">
        <item name="cornerSize">24dp</item>
    </style>
    <style name="Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/focus_glow</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="ThemeOverlay.MBFileManager.Sheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/MBSheet</item>
    </style>
    <style name="MBSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>
    <style name="GlassIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#401E88E5</item>
        <item name="shapeAppearance">@style/GlassIndicatorShape</item>
    </style>
    <style name="GlassIndicatorShape">
        <item name="cornerSize">50%</item>
    </style>
</resources>
